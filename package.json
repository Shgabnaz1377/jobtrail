{
  "name": "jobtrail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Track job applications from wishlist to offer.",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
