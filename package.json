    "vue": "^3.5.46",
    "vue-router": "5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@vue/test-utils": "^2.6.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "typescript": "~5.9.3",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
