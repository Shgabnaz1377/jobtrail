# Postgres connection string (Neon). Leave empty locally to use the built-in PGlite database.
DATABASE_URL=

# Secret used to seal session cookies. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# Local PGlite data directory (ignored when DATABASE_URL is set). Use memory:// for a throwaway database.
PGLITE_DATA_DIR=.data/pglite

# Shared secret for the demo-cleanup cron route. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>" when the variable is set on the project.
CRON_SECRET=
